# Copy to .env. Compose reads this file; do not commit real credentials.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-random-url-safe-password
POSTGRES_PORT=5432
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
NODE_AGENT_PORT=3101
BACKEND_PORT=3100

# Generate distinct random tokens (32+ characters). Never use these placeholders.
API_TOKEN=replace-with-random-user-token-at-least-32-characters
NODE_SHARED_TOKEN=replace-with-different-random-node-token-at-least-32-characters
DATABASE_URL=postgresql://agent:replace-with-random-url-safe-password@127.0.0.1:5432/agent
BACKEND_URL=http://127.0.0.1:3100
NODE_ENDPOINT=http://127.0.0.1:3101
NODE_ENDPOINT_ALLOWLIST=http://127.0.0.1:3101,http://node-agent:3101,http://host.docker.internal:3101
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JEV_API_KEY=
# RUNTIME_CONFIG=/absolute/path/to/operator-approved-runtime.json
# Without RUNTIME_CONFIG, discover installed local Ollama models and benchmark Gemma 4/Qwen.
OLLAMA_AUTO_DISCOVER=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MIN_TOKENS_PER_SECOND=20
# Optional preferred order; every selected model must still pass the speed requirement.
# OLLAMA_MODEL_PRIORITY=qwen3.8:27b-mlx,gemma4:31b-mlx
# All coding tools are enabled by default. Set ENABLED_TOOLS= to disable all.
# ENABLED_TOOLS=read,bash,edit,write,grep,find,ls

# MODE is selected explicitly by compose.yaml (PROD) or its DEV override.
# Native node-agent configuration is documented in apps/node-agent/README.md.
# Unset or blank AGENT_WORKSPACE_DIR uses ~/.curilo/workspace/chat_sessions/<conversation-id>.
# AGENT_WORKSPACE_DIR=/absolute/path/to/project

# Browser shell access runs as the node's OS user, independently of model tools.
TERMINAL_ENABLED=true
TERMINAL_MAX_SESSIONS=8
TERMINAL_IDLE_TIMEOUT_MS=1800000
TERMINAL_MAX_LIFETIME_MS=86400000
